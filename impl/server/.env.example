# LLM（生成与查词共用；DeepSeek 兼容端点）
LLM_API_KEY=<必填>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 时区：所有日期语义以此为准；须与系统时区一致（Asia/Shanghai）
TIMEZONE=Asia/Shanghai
# 数据库与检查点
DB_PATH=./data/contexta.db
CHECKPOINT_PATH=./data/langgraph.sqlite
OUTPUT_DIR=./output
# 引擎并发
BROWSER_CONCURRENCY=2
SLOT_CONCURRENCY=5
# 出站代理（可选）
PROXY_URL=
# 服务端
PORT=8080
JWT_SECRET=<必填, >=32 字符>
ADMIN_INIT_PASSWORD=<首次启动必填>
WORD_QUOTA_DAILY=200
CACHE_TTL_DAYS=30
CACHE_MAX_ROWS=5000
DAILY_GENERATE_HOUR=3
LLM_TIMEOUT_SECS=90
REGENERATE_LIMIT=3
