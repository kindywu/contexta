# LLM（生成与查词共用；DeepSeek 兼容端点）
LLM_API_KEY=<必填>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 时区：所有日期语义以此为准；须与系统时区一致（Asia/Shanghai）
TIMEZONE=Asia/Shanghai
# 数据库与检查点
DB_PATH=./data/contexta.db
CHECKPOINT_PATH=./data/langgraph.sqlite
OUTPUT_DIR=./output
# 引擎并发
BROWSER_CONCURRENCY=2
SLOT_CONCURRENCY=5
# 出站代理（可选）
PROXY_URL=
# 服务端
PORT=8080
JWT_SECRET=<必填, >=32 字符>
ADMIN_JWT_SECRET=<必填, >=32 字符>  # admin（Web 管理端）令牌密钥，与 JWT_SECRET 分开（双密钥鉴权）
ADMIN_INIT_PASSWORD=<首次启动必填>
WORD_QUOTA_DAILY=200
CACHE_TTL_DAYS=30
CACHE_MAX_ROWS=5000
# 每日生成窗口（HH:MM-HH:MM；窗口内触发只生成当天 15 篇，错过跳过不补）
# 本地测试可改为其他时段（如 12:00-12:30）
DAILY_GENERATE_WINDOW=08:00-08:15
LLM_TIMEOUT_SECS=90
REGENERATE_LIMIT=3
