[Unit]
Description=Contexta Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contexta
WorkingDirectory=/opt/contexta/server
EnvironmentFile=/opt/contexta/server/.env
ExecStart=/usr/local/bin/bun run src/main.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
