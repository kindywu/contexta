<?xml version="1.0" encoding="utf-8"?>
<!-- 自签名 HTTPS（固定 IP、无域名）信任链——见 impl/server/docs/config-and-deploy.md §2.1。

     只对 47.112.20.32（生产 API）追加内嵌证书为信任锚：
       - 该 IP 之外的所有域名/地址仍走系统信任库（不削弱全局安全性）；
       - cleartextTrafficPermitted=true 保留，供本地/局域网调试用 HTTP 连开发服务器。

     ⚠️ 纪律：res/raw/contexta_server.crt 必须与服务器 /opt/contexta/server/certs/server.crt
     是同一份证书。更换 IP 或重签证书后，必须同步替换该文件并重新打包，否则已装 App 握手即断。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config>
        <domain includeSubdomains="false">47.112.20.32</domain>
        <trust-anchors>
            <certificates src="@raw/contexta_server" />
        </trust-anchors>
    </domain-config>
</network-security-config>
